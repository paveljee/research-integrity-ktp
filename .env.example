# Environment variables for the Author Matching Pipeline

# Path to the input Excel file containing author names.
# The Excel file should have a column named 'name' (case-insensitive).
EXCEL_FILE_PATH="path/to/your/names.xlsx"

# Path to the authors Parquet file (e.g., from SciSciNet v2 dataset).
# Expected schema includes: 'authorid', 'avg_c10', 'avg_logc10', 'productivity', 'h_index', 'display_name', etc.
AUTHORS_PARQUET_PATH="path/to/your/authors-00000-of-00001.parquet"

# Path to the author_details Parquet file (e.g., from SciSciNet v2 dataset).
# Expected schema includes: 'authorid', 'orcid', 'display_name_alternatives', 'works_count', 'cited_by_count', etc.
AUTHOR_DETAILS_PARQUET_PATH="path/to/your/author_details-00000-of-00001.parquet"

# Optional: OpenAlex API configuration (if needed, though pyalex works without for most public data)
# OPENALEX_EMAIL="your_email@example.com"
